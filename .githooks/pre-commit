#!/usr/bin/env bash
#
# Refuse to commit anything that looks like a credential. Pattern-based, not entropy-based:
# the repo is full of test keys and base64 vectors an entropy heuristic would flag constantly.
set -euo pipefail

fail=0
note() { echo "pre-commit: $*" >&2; fail=1; }

# Files whose name alone says they hold key material.
while IFS= read -r path; do
    case "$path" in
        *.pem|*.p12|*.pfx|*identity.key|*.mobileprovision|.env|*/.env)
            note "refusing to commit $path — that name is key material"
            ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACM)

staged="$(git diff --cached --unified=0 --diff-filter=ACM | grep '^+' | grep -v '^+++' || true)"
[ -z "$staged" ] && exit 0

check() {
    if printf '%s' "$staged" | grep -qE -- "$1"; then
        note "a staged line looks like $2"
    fi
}

check '-----BEGIN [A-Z ]*PRIVATE KEY-----'        "a private key block"
check 'AKIA[0-9A-Z]{16}'                          "an AWS access key id"
check 'gh[pousr]_[A-Za-z0-9]{30,}'                "a GitHub token"
check 'xox[baprs]-[A-Za-z0-9-]{10,}'              "a Slack token"
check 'sk-ant-[A-Za-z0-9_-]{20,}'                 "an Anthropic API key"
check 'AIza[0-9A-Za-z_-]{35}'                     "a Google API key"
check "(api[_-]?key|secret|password|token)[\"' ]*[:=][\"' ]*[A-Za-z0-9/+_-]{24,}" \
                                                  "a hard-coded credential"

# No comment blocks over 2 lines: keep the invariant, drop the essay.
while IFS= read -r path; do
    case "$path" in
        *.rs|*.swift|*.c|*.h) re='^[[:space:]]*(//|/[*]|[*])'
                              bare='^[[:space:]]*(/?/+!?|[*])[[:space:]]*$' ;;
        *.sh|.githooks/*)     re='^[[:space:]]*#'
                              bare='^[[:space:]]*#[[:space:]]*$' ;;
        *) continue ;;
    esac
    block=$(git diff --cached -U0 -- "$path" | awk -v re="$re" -v bare="$bare" '
        /^\+\+\+/ {next}
        /^\+/ {line=substr($0,2)
               if (line ~ bare) next
               if (line ~ re) {run++; if (run>max) max=run; next}}
        {run=0}
        END {print max+0}')
    if [ "$block" -gt 2 ]; then
        note "$path adds a comment block of $block lines (max 2)"
    fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "$fail" -ne 0 ]; then
    cat >&2 <<'EOF'

Nothing here should carry a credential, and comments stay under 3 lines. If
this is a false positive — a test vector, a sanctioned block — commit with
--no-verify and say so in the message.
EOF
    exit 1
fi
