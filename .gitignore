/target
/target/swift
**/*.rs.bk

# iOS: the project is generated from ios/project.yml, never checked in.
/ios/*.xcodeproj
/ios/*.xcworkspace
/ios/Generated
/ios/build
*.xcframework

# Machine-specific: local SOCKS proxy for cargo. Not portable.
/.cargo/config.toml

# UniFFI output, produced by the build.
/ios/Generated
/target/xcodegen

# cargo-mutants output. Regenerated on every run, and its lock.json records the
# hostname and username of whoever ran it.
/mutants.out
/mutants.out.old
/mutants.out.*
