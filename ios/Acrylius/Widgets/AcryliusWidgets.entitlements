<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Identical to the app's, and it has to be: the group is the only thing
         these two processes share, and a typo here produces a widget that
         builds, installs, runs, and is permanently empty. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.org.acrylius</string>
    </array>
</dict>
</plist>
